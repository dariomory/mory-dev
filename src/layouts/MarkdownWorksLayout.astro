---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from './Layout.astro';
import { logoTransitionName } from '../utils/transitionName';
const { frontmatter, url } = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';
const canonicalPath = `${url}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl + '/').href;
const pageTitle = `${frontmatter.title} — Dario Mory`;

/* Contributions are changes to someone else's codebase; projects are delivered
   work. Different schema types, so a reader of the graph can tell them apart. */
const isContribution = url.startsWith('/contributions/');

/* Only render showcase images that actually exist in public/ */
const publicImageExists = (url?: string) =>
    !!url && fs.existsSync(path.join(process.cwd(), 'public', url));

const worksImages = [frontmatter.worksImage1, frontmatter.worksImage2].filter(
    (img) => img?.url && publicImageExists(img.url)
);

/* Social/OG image: prefer a showcase screenshot, then the project logo (raster only) */
const isRaster = (url?: string) => !!url && /\.(png|jpe?g|webp|gif)$/i.test(url);
const ogImage = isRaster(worksImages[0]?.url)
    ? worksImages[0].url
    : isRaster(frontmatter.image?.url)
      ? frontmatter.image.url
      : undefined;
const workSchema = {
    '@context': 'https://schema.org',
    '@type': isContribution ? 'SoftwareSourceCode' : 'CreativeWork',
    '@id': `${canonicalUrl}#work`,
    name: frontmatter.title,
    description: frontmatter.description,
    url: canonicalUrl,
    inLanguage: 'en',
    ...(frontmatter.role && { creditText: frontmatter.role }),
    ...(frontmatter.stack && { keywords: frontmatter.stack }),
    ...(frontmatter.stack && isContribution && { programmingLanguage: frontmatter.stack }),
    ...(frontmatter.github && { codeRepository: frontmatter.github }),
    ...(frontmatter.updated && {
        dateModified: new Date(frontmatter.updated).toISOString().split('T')[0],
    }),
    ...(ogImage && { image: new URL(ogImage, siteUrl + '/').href }),
    /* Same Person node the apps, books and posts point at, so client work reads
       as one person's portfolio rather than unrelated pages. */
    author: { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Dario Mory', url: `${siteUrl}/` },
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Works', item: `${siteUrl}/works/` },
        { '@type': 'ListItem', position: 3, name: frontmatter.title, item: canonicalUrl },
    ],
};
---
<BaseLayout
    pageTitle={pageTitle}
    description={frontmatter.description}
    canonicalPath={canonicalPath}
    ogImage={ogImage}
    ogImageAlt={frontmatter.image?.alt}
    jsonLd={[workSchema, breadcrumbSchema]}
>
    <div class="page-head">
        {frontmatter.image?.url && (
            <img
                class="page-logo"
                src={frontmatter.image.url}
                alt={frontmatter.image.alt ?? ''}
                width="44" height="44"
                decoding="async"
                transition:name={logoTransitionName(url)}
            />
        )}
        <h1>{frontmatter.title}</h1>
    </div>
    <div class="works-body"><slot /></div>
    {frontmatter.role && <p><small>ROLE</small>{frontmatter.role}</p>}
    {frontmatter.platform && <p><small>PLATFORM</small>{frontmatter.platform}</p>}
    {frontmatter.stack && <p><small>STACK</small>{frontmatter.stack}</p>}
    {frontmatter.website && <p><small>WEBSITE</small><a href={frontmatter.website} target="_blank">{frontmatter.website}</a></p>}
    {frontmatter.github && <p><small>GITHUB</small><a href={frontmatter.github} target="_blank">{frontmatter.github}</a></p>}
    {worksImages.length > 0 && (
        <div class="img">
            {worksImages.map((img) => (
                <img src={img.url} alt={img.alt} class="project-img" loading="lazy" decoding="async"/>
            ))}
        </div>
    )}
</BaseLayout>
<style>
    .page-head {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0.83em 0 0;
    }

    .page-logo {
        width: 44px;
        height: 44px;
        object-fit: contain;
        flex-shrink: 0;
        border-radius: 6px;
    }

    h1 {
        font-size: 1.5em;
        text-decoration: underline #375a7f;
        text-decoration-thickness: 4px;
        text-underline-offset: 6px;
        margin: 0;
    }

    .works-body :global(h3) {
        font-family: 'Josefin Sans', sans-serif;
        font-size: 1.15em;
        color: #fdebf3;
        margin: 1.6em 0 0;
    }

    .img {
        text-align: center;
    }

    img {
        border-radius: 16px;
        margin-top: 10px;
    }

    .project-img {
        max-width: 360px;
    }

    small {
        background-color: #584966;
        color: #fdebf3;
        border-radius: 6px;
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.7em;
        font-weight: 600;
        margin-right: 5px;
        padding: 0.3em 0.3em;
    }

    a {
        color: #78c2ad;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    @media only screen and (max-width: 600px) {
        img {
            width: 300px;
        }
    }
</style>
