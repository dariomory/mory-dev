---
import { ViewTransitions } from 'astro:transitions';
import { fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PersonSchema from '../components/PersonSchema.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props {
	pageTitle: string;
	preloadImage?: string;
	description?: string;
	canonicalPath?: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogType?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	pageTitle,
	preloadImage,
	description,
	canonicalPath,
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	ogType,
	twitterCard,
	jsonLd,
} = Astro.props;
---
<!DOCTYPE html>
<html transition:animate="none" lang="en">
	<head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <script is:inline>document.documentElement.classList.add('js');</script>
        <link rel="icon" type="image/png" sizes="512x512" href="/favicon-round-512.png" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon-round-48.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-round-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="alternate" type="application/rss+xml" title="Dario Mory" href="/rss.xml" />
        {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans&family=Pacifico&display=swap" rel="stylesheet">        
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <SeoHead
            pageTitle={pageTitle}
            description={description}
            canonicalPath={canonicalPath}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            ogImageWidth={ogImageWidth}
            ogImageHeight={ogImageHeight}
            ogType={ogType}
            twitterCard={twitterCard}
            jsonLd={jsonLd}
        />
        <PersonSchema />
        <ViewTransitions />
	</head>
	<body>
        <Header />
        <main transition:animate={fade({ duration: '0.4s' })} >
	    <slot />
            <Footer />
        </main>
        <script>
            // Images decode after first paint, so each one clears its own spinner.
            // Runs on astro:page-load so it also covers view-transition navigations.
            function whenSettled(img, done) {
                // Cached images can already be complete before this runs.
                if (img.complete && img.naturalWidth > 0) {
                    done();
                    return;
                }
                img.addEventListener('load', done, { once: true });
                // On error too, otherwise a broken image spins forever.
                img.addEventListener('error', done, { once: true });
            }

            function initImageLoaders() {
                document.querySelectorAll('.link-card .card-img').forEach((img) => {
                    const slot = img.closest('.img');
                    if (slot?.classList.contains('is-loaded')) return;
                    whenSettled(img, () => {
                        img.classList.add('is-loaded');
                        slot?.classList.add('is-loaded');
                    });
                });

                document.querySelectorAll('.raccoon-frame > img').forEach((img) => {
                    const loader = img.parentElement.querySelector('.frame-loader');
                    if (loader && !loader.classList.contains('is-loaded')) {
                        // No class on the image itself — it is the LCP element and must
                        // not be held at opacity 0 waiting on a transition.
                        whenSettled(img, () => loader.classList.add('is-loaded'));
                    }

                    // The animated original is ~80x the poster's weight. Fetch it only
                    // once the poster has painted and the browser is idle, and decode it
                    // fully off-screen before swapping, so the visible frame never blanks.
                    const animated = img.dataset.animated;
                    if (!animated || img.dataset.animatedPending) return;
                    img.dataset.animatedPending = '1';
                    whenSettled(img, () => {
                        const load = () => {
                            const full = new Image();
                            full.decoding = 'async';
                            full.addEventListener('load', () => { img.src = animated; }, { once: true });
                            full.src = animated;
                        };
                        if ('requestIdleCallback' in window) {
                            requestIdleCallback(load, { timeout: 2000 });
                        } else {
                            setTimeout(load, 200);
                        }
                    });
                });
            }

            document.addEventListener('astro:page-load', initImageLoaders);
        </script>
	</body>
</html>
