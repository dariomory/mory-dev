---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from './Layout.astro';
import { logoTransitionName } from '../utils/transitionName';
import { BASED_IN } from '../utils/identity';
import Faq from '../components/Faq.astro';

const { frontmatter, url } = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';
const canonicalPath = `${url}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl + '/').href;
const pageTitle = frontmatter.seoTitle ?? `${frontmatter.title} — Dario Mory`;

/* Only render showcase images that actually exist in public/, so an app page can
   ship before its screenshots do. */
const publicImageExists = (url?: string) =>
    !!url && fs.existsSync(path.join(process.cwd(), 'public', url));

const appImages = [frontmatter.appImage1, frontmatter.appImage2].filter(
    (img) => img?.url && publicImageExists(img.url)
);

/* Social/OG image: prefer a screenshot, then the app mark (raster only — an SVG
   mark is crisp on the page but is not a valid og:image). */
const isRaster = (url?: string) => !!url && /\.(png|jpe?g|webp|gif)$/i.test(url);
const ogImage = isRaster(appImages[0]?.url)
    ? appImages[0].url
    : isRaster(frontmatter.image?.url)
      ? frontmatter.image.url
      : undefined;

const softwareSchema = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    /* Same @id on /about/ and /apps/, so all three pages describe one node per
       product rather than three anonymous look-alikes. url points at the product
       itself; mainEntityOfPage names the page here that is about it. */
    '@id': `${canonicalUrl}#software`,
    mainEntityOfPage: canonicalUrl,
    name: frontmatter.title,
    description: frontmatter.description,
    url: frontmatter.website ?? canonicalUrl,
    applicationCategory: frontmatter.appCategory,
    ...(frontmatter.operatingSystem && { operatingSystem: frontmatter.operatingSystem }),
    ...(frontmatter.version && { softwareVersion: frontmatter.version }),
    ...(frontmatter.license && { license: frontmatter.license }),
    /* Tiered products need AggregateOffer: a flat Offer would state one price for
       something sold at several, or hide a free tier behind a paid one. */
    offers: frontmatter.priceHigh
        ? {
              '@type': 'AggregateOffer',
              lowPrice: String(frontmatter.price ?? '0'),
              highPrice: String(frontmatter.priceHigh),
              priceCurrency: frontmatter.priceCurrency ?? 'USD',
              ...(frontmatter.offerCount && { offerCount: frontmatter.offerCount }),
          }
        : {
              '@type': 'Offer',
              price: String(frontmatter.price ?? '0'),
              priceCurrency: frontmatter.priceCurrency ?? 'USD',
          },
    /* Binds every app to the one Person entity emitted by PersonSchema.astro, so
       every product reads as one author's portfolio rather than a set of strangers. */
    author: {
        '@type': 'Person',
        '@id': `${siteUrl}/#person`,
        name: 'Dario Mory',
        url: `${siteUrl}/`,
    },
    ...(frontmatter.sameAs?.length && { sameAs: frontmatter.sameAs }),
    ...(ogImage && { screenshot: new URL(ogImage, siteUrl + '/').href }),
    ...(frontmatter.image?.url && { image: new URL(frontmatter.image.url, siteUrl + '/').href }),
};

/* FAQ markup no longer earns a rich result for a site like this one — Google
   restricted those to gov/health domains. It is here for retrieval: a question
   with a self-contained answer is the shape an assistant can lift wholesale,
   which a paragraph of prose is not. */
const faq = (frontmatter.faq ?? []).filter((item: { q?: string; a?: string }) => item?.q && item?.a);

const faqSchema = faq.length
    ? {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          '@id': `${canonicalUrl}#faq`,
          mainEntity: faq.map((item: { q: string; a: string }) => ({
              '@type': 'Question',
              name: item.q,
              acceptedAnswer: { '@type': 'Answer', text: item.a },
          })),
      }
    : undefined;

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Apps', item: `${siteUrl}/apps/` },
        { '@type': 'ListItem', position: 3, name: frontmatter.title, item: canonicalUrl },
    ],
};
---
<BaseLayout
    pageTitle={pageTitle}
    description={frontmatter.description}
    canonicalPath={canonicalPath}
    ogImage={ogImage}
    ogImageAlt={frontmatter.image?.alt}
    jsonLd={[softwareSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])]}
>
    <div class="page-head">
        {frontmatter.image?.url && (
            <img
                class="page-logo"
                src={frontmatter.image.url}
                alt={frontmatter.image.alt ?? ''}
                width="44" height="44"
                decoding="async"
                transition:name={logoTransitionName(url)}
            />
        )}
        <h1>{frontmatter.title}</h1>
    </div>
    {frontmatter.tagline && <p class="tagline">{frontmatter.tagline}</p>}
    <div class="app-body"><slot /></div>
    {/* "Who built FormHarvester?" scored 1/8 in the PromptWatch run and "Who built
        HexDigest?" 0/8, while authorship existed on these pages only inside JSON-LD
        — the weakest possible place to put the single fact being asked for. It is
        first in the spec block now, and stated again as a sentence below. */}
    <p><small>BUILT BY</small><a href="/about/">Dario Mory</a></p>
    {frontmatter.status && <p><small>STATUS</small>{frontmatter.status}</p>}
    {frontmatter.pricing && <p><small>PRICING</small>{frontmatter.pricing}</p>}
    {frontmatter.platform && <p><small>PLATFORM</small>{frontmatter.platform}</p>}
    {frontmatter.stack && <p><small>STACK</small>{frontmatter.stack}</p>}
    {frontmatter.install && <p><small>INSTALL</small><code>{frontmatter.install}</code></p>}
    {frontmatter.website && (
        <p><small>WEBSITE</small><a href={frontmatter.website} target="_blank" rel="noopener">{frontmatter.website.replace(/^https?:\/\//, '')}</a></p>
    )}
    {frontmatter.github && (
        <p><small>GITHUB</small><a href={frontmatter.github} target="_blank" rel="noopener">{frontmatter.github.replace(/^https?:\/\/(www\.)?github\.com\//, '')}</a></p>
    )}
    {faq.length > 0 && (
        <section class="faq">
            <h2>Questions</h2>
            <Faq items={faq} />
        </section>
    )}
    {appImages.length > 0 && (
        <div class="img">
            {appImages.map((img) => (
                <img src={img.url} alt={img.alt} class="app-img" loading="lazy" decoding="async"/>
            ))}
        </div>
    )}
    {/* Names subject and creator in one sentence, so it survives being lifted out
        of the page without the surrounding context. */}
    <p class="authorship">
        {frontmatter.title} is built and maintained by <a href="/about/">Dario Mory</a>, an
        engineering leader based in the {BASED_IN} who also takes
        <a href="/advisory/">fractional CTO and advisory engagements</a>.
    </p>
    <p class="back"><a href="/apps/">← All apps</a></p>
</BaseLayout>
<style>
    .page-head {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0.83em 0 0;
    }

    .page-logo {
        width: 44px;
        height: 44px;
        object-fit: contain;
        flex-shrink: 0;
        border-radius: 6px;
    }

    h1 {
        font-size: 1.5em;
        text-decoration: underline #375a7f;
        text-decoration-thickness: 4px;
        text-underline-offset: 6px;
        margin: 0;
    }

    .tagline {
        font-family: 'Josefin Sans', sans-serif;
        font-style: italic;
        color: #c9b8d8;
        text-indent: 0;
        margin: 0.6em 0 0;
    }

    .app-body :global(h3) {
        font-family: 'Josefin Sans', sans-serif;
        font-size: 1.15em;
        color: #fdebf3;
        margin: 1.6em 0 0;
    }

    .faq {
        margin-top: 2rem;
    }

    .faq h2 {
        font-family: 'Josefin Sans', sans-serif;
        font-size: 1.05em;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #c9b8d8;
        margin: 0 0 0.4em;
    }

    .img {
        text-align: center;
    }

    img {
        border-radius: 16px;
        margin-top: 10px;
    }

    .app-img {
        max-width: 360px;
    }

    small {
        background-color: #584966;
        color: #fdebf3;
        border-radius: 6px;
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.7em;
        font-weight: 600;
        margin-right: 5px;
        padding: 0.3em 0.3em;
    }

    code {
        font-size: 0.85em;
        background: rgba(253, 235, 243, 0.06);
        border: 1px solid rgba(253, 235, 243, 0.1);
        border-radius: 5px;
        padding: 0.1em 0.4em;
    }

    a {
        color: #78c2ad;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .authorship {
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.9em;
        color: #c9b8d8;
        text-indent: 0;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(253, 235, 243, 0.1);
    }

    .back {
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.9em;
        text-indent: 0;
        margin-top: 2rem;
    }

    .authorship + .back {
        margin-top: 1rem;
    }

    @media only screen and (max-width: 600px) {
        img {
            width: 300px;
        }
    }
</style>
