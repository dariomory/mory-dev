---
/*
 * A scanner reading the entity, sitting directly above the facts panel so the
 * panel reads as its output rather than as a list that happens to follow it.
 *
 * Same vocabulary as the apps hologram and the nav hex: teal wireframe on a
 * faint grid, one bright element, everything else dim. No JS — the whole
 * thing is SVG plus CSS transforms, so it costs nothing at runtime and stops
 * completely under prefers-reduced-motion.
 *
 * The readout bars are deterministic rather than random: a fixed sequence keeps
 * the silhouette stable between builds, and a spectrum that changed on every
 * deploy would read as noise rather than as an instrument.
 */
const bars = [7, 13, 9, 19, 11, 24, 15, 10, 21, 8, 17, 12, 26, 14, 9, 18, 11, 22, 10, 16];
const hex = (cx: number, cy: number, r: number) =>
    [0, 1, 2, 3, 4, 5]
        .map((i) => {
            const a = (Math.PI / 3) * i - Math.PI / 2;
            return `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`;
        })
        .join(' ');
---
<div class="scanner" role="img" aria-label="Decorative holographic scanner reading the profile below">
    <svg viewBox="0 0 400 104" preserveAspectRatio="none" class="scan-grid" aria-hidden="true">
        {[...Array(9)].map((_, i) => (
            <line x1={i * 50} y1="0" x2={i * 50} y2="104" vector-effect="non-scaling-stroke" />
        ))}
        {[...Array(4)].map((_, i) => (
            <line x1="0" y1={i * 34} x2="400" y2={i * 34} vector-effect="non-scaling-stroke" />
        ))}
    </svg>

    <svg viewBox="0 0 400 104" class="scan-art" aria-hidden="true" focusable="false">
        {/* targeting brackets */}
        <g class="brackets">
            <path d="M6 22V6h16" /><path d="M394 22V6h-16" />
            <path d="M6 82v16h16" /><path d="M394 82v16h-16" />
        </g>

        {/* the reticle — three hexes at different scales, the same shape as the
            nav mark, so the two read as one system */}
        <g class="reticle" transform="translate(52 52)">
            <polygon class="ring ring-1" points={hex(0, 0, 26)} />
            <polygon class="ring ring-2" points={hex(0, 0, 26)} />
            <polygon class="ring ring-3" points={hex(0, 0, 26)} />
            <polygon class="core" points={hex(0, 0, 6)} />
        </g>

        {/* readout spectrum */}
        <g class="bars">
            {bars.map((h, i) => (
                <rect x={110 + i * 14} y={52 - h / 2} width="5" height={h} rx="1.5" style={`--i:${i}`} />
            ))}
        </g>

        {/* baseline the bars sit on */}
        <line class="baseline" x1="104" y1="78" x2="392" y2="78" />
    </svg>

</div>
<style>
    .scanner {
        position: relative;
        height: 104px;
        margin: 1.6em 0 0;
        border: 1px solid rgba(120, 194, 173, 0.24);
        border-radius: 14px;
        overflow: hidden;
        background:
            radial-gradient(120% 100% at 50% 0%, rgba(120, 194, 173, 0.1), rgba(88, 73, 102, 0.14));
    }

    .scan-grid,
    .scan-art {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .scan-grid line {
        stroke: rgba(120, 194, 173, 0.13);
        stroke-width: 1;
    }

    .scan-art {
        fill: none;
        stroke: #78c2ad;
        stroke-width: 1.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .brackets path {
        stroke: rgba(120, 194, 173, 0.75);
        stroke-width: 1.8;
    }

    /* Rings converge at the top and bottom vertices, so the shape reads as one
       object turning rather than three outlines stacked. */
    .ring {
        transform-box: fill-box;
        transform-origin: center;
        stroke: rgba(120, 194, 173, 0.85);
        animation: scan-spin 7s linear infinite;
    }

    .ring-2 { animation-delay: -2.33s; opacity: 0.6; }
    .ring-3 { animation-delay: -4.66s; opacity: 0.38; }

    .core {
        fill: #d9fff4;
        stroke: none;
        transform-box: fill-box;
        transform-origin: center;
        animation: scan-core 2.4s ease-in-out infinite;
    }

    .bars rect {
        fill: rgba(196, 255, 238, 0.5);
        stroke: none;
        transform-box: fill-box;
        transform-origin: center;
        /* Staggered off one index so the row ripples instead of pulsing as a block. */
        animation: scan-bar 2.8s ease-in-out infinite;
        animation-delay: calc(var(--i) * -0.14s);
    }

    .baseline {
        stroke: rgba(120, 194, 173, 0.35);
        stroke-width: 1;
    }

    @keyframes scan-spin {
        from { transform: rotateY(0deg); }
        to   { transform: rotateY(360deg); }
    }

    @keyframes scan-core {
        0%, 100% { opacity: 0.7; transform: scale(0.82); }
        50%      { opacity: 1;   transform: scale(1.16); }
    }

    @keyframes scan-bar {
        0%, 100% { transform: scaleY(0.55); opacity: 0.4; }
        50%      { transform: scaleY(1.25); opacity: 0.9; }
    }

    @media (prefers-reduced-motion: reduce) {
        .ring, .core, .bars rect {
            animation: none;
        }

        .ring-1 { transform: scaleX(1); }
        .ring-2 { transform: scaleX(0.5); }
        .ring-3 { transform: scaleX(0.06); }
    }

    @media only screen and (max-width: 600px) {
        .scanner { height: 88px; }
    }
</style>
