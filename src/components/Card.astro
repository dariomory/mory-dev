---
interface Props {
    url: string;
    image: string;
    title: string;
    body: string;
}

const { url, image, title, body } = Astro.props;
---
<li class="link-card">
    <a href={url}>
        <div class="img">
            <img src={image} class="card-img" alt="" loading="lazy" decoding="async">
        </div>
	<h3 class="card-title">
	    {title}
	</h3>
	<p class="card-txt">
	    {body}
        </p>
    </a>
</li>
<style>
    .link-card {
        --thumb-width: 148px;
        --thumb-height: 94px;
        list-style: none;
        display: flex;
        background-size: 400%;
        padding: 0 10px;
        transition: transform 0.25s ease;
    }

    .link-card > a {
        width: 100%;
        text-decoration: none;
        line-height: 1.4;
        border-radius: 14px;
        color: #fdebf3;
        background: rgba(253, 235, 243, 0.04);
        border: 1px solid rgba(253, 235, 243, 0.08);
        padding: 0.9rem 0.75rem 0.75rem;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
        transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
    }

    .link-card > a:hover {
        border-color: rgba(120, 194, 173, 0.45);
        background: rgba(253, 235, 243, 0.065);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    .link-card > a:focus-visible {
        outline: 2px solid #78c2ad;
        outline-offset: 4px;
    }

    .img {
        text-align: center;
        width: var(--thumb-width);
        height: var(--thumb-height);
        margin: 0 auto 0.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    img {
        max-width: var(--thumb-width);
        max-height: var(--thumb-height);
        width: auto;
        height: auto;
        display: block;
        flex-shrink: 0;
        border-radius: 8px;
        object-fit: contain;
        image-rendering: auto;
    }

    h3 {
        margin: 0;
        font-family: 'Josefin Sans', sans-serif;
        font-size: 1rem;
        font-weight: normal;
        text-align: center;
    }

    p {
        font-size: 0.75em;
        line-height: 1.5;
        text-indent: 0;
        text-align: center;
        margin: 0.1rem 0;
    }

    .link-card:hover {
        transform: scale(1.05);
    }

    @media only screen and (max-width: 600px) {
        .link-card {
            --thumb-width: 168px;
            --thumb-height: 107px;
        }
    }
</style>
