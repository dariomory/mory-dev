---
import {
    AVAILABLE,
    CANONICAL_DESCRIPTION,
    EMAIL,
    JOB_TITLE,
    PROFILES,
    SERVICES,
} from '../utils/identity';

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';

// jobTitle was 'Lead Software Engineer' while the page title, H1 kicker and nav all
// said 'Engineering Leader'. Aligned to the visible identity — the schema should
// not be the one place claiming a different role.
const personSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Dario Mory',
    url: `${siteUrl}/`,
    email: EMAIL,
    jobTitle: JOB_TITLE,
    description: CANONICAL_DESCRIPTION,
    // Names the one page that is *about* this person. Engines currently conflate
    // him with unrelated people of the same name; this is the cheapest signal that
    // says which page is the record.
    mainEntityOfPage: { '@id': `${siteUrl}/about/#profilepage` },
    // Both already visible in the facts panel and the FAQ on /about/.
    homeLocation: { '@type': 'Place', name: 'Netherlands' },
    address: { '@type': 'PostalAddress', addressCountry: 'NL' },
    nationality: { '@type': 'Country', name: 'Spain' },
    // The engagements on /advisory/, carried in full rather than as a bare @id
    // reference. This component renders on every page, but those Service nodes are
    // only *defined* on /advisory/ — so on the other 45 the reference resolved to
    // nothing at all. The @id is still the one /advisory/ emits, which is what lets
    // a parser merge the two into a single node where both appear instead of
    // describing two look-alikes.
    // Answers "is Dario Mory available for advisory work" from any page on the site.
    makesOffer: SERVICES.map((service) => ({
      '@type': 'Offer',
      availability: AVAILABLE
        ? 'https://schema.org/InStock'
        : 'https://schema.org/SoldOut',
      url: `${siteUrl}/advisory/`,
      itemOffered: {
        '@type': 'Service',
        '@id': `${siteUrl}/advisory/#${service.id}`,
        name: service.name,
        serviceType: service.name,
        description: service.summary,
        provider: { '@id': `${siteUrl}/#person` },
      },
    })),
    hasOccupation: {
      '@type': 'Occupation',
      name: JOB_TITLE,
      // O*NET: Computer and Information Systems Managers
      occupationalCategory: '11-3021.00',
    },
    // Every entry below is a technology or domain that appears in the `stack`
    // frontmatter of a shipped app or a delivered project on this site. Nothing
    // aspirational — an unbacked claim here is the kind of thing a retrieval model
    // will happily repeat, so the list stays sourced.
    knowsAbout: [
      'Software engineering leadership',
      'Government digital services',
      'Software architecture',
      'Cloud migration',
      'API design',
      'Large language model applications',
      'Model Context Protocol',
      'Web scraping',
      'Python',
      'C++',
      'JavaScript',
      'Go',
      'Rust',
      'Elixir',
      'Django',
      'FastAPI',
      'Next.js',
      'React',
      'Vue.js',
      'Astro',
      'Tauri',
      'Scrapy',
      'Selenium',
      'PostgreSQL',
      'SQLite',
      'GraphQL',
      'Kubernetes',
      'Amazon Web Services',
      'Google Cloud Platform',
      'Microsoft Azure',
      'Cloudflare Workers',
    ],
    sameAs: PROFILES,
};

const websiteSchema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: 'Dario Mory',
    alternateName: 'mory.dev',
    author: { '@id': `${siteUrl}/#person` },
};

// Google uses WebSite markup from the domain homepage to determine the site name.
const schema = Astro.url.pathname === '/'
  ? [personSchema, websiteSchema]
  : personSchema;
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
