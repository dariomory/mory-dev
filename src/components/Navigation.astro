---
const path = Astro.url.pathname;

// Deep pages keep their section lit: a project or contribution still lives under Works.
// `featured` is declared on the type, not just one literal, so link.featured stays accessible.
const links: { href: string; label: string; match: string[]; featured?: boolean }[] = [
    { href: '/apps/', label: 'Apps', match: ['/apps'], featured: true },
    { href: '/works/', label: 'Works', match: ['/works', '/projects', '/contributions'] },
    { href: '/books/', label: 'Books', match: ['/books'] },
    { href: '/posts/', label: 'Posts', match: ['/posts'] },
];

const isCurrent = (match: string[]) =>
    match.some((p) => path === p || path.startsWith(p + '/'));
---
<div class="nav-bar">
    <div class="title-link">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Dario Mory</a>
    </div>
    <div class="nav-links">
        {links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
                {link.featured && (
                    <svg class="nav-holo" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
                        <g class="holo-meridians">
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                        </g>
                        <polygon class="holo-core" points="0,-2.8 2.42,-1.4 2.42,1.4 0,2.8 -2.42,1.4 -2.42,-1.4" />
                    </svg>
                )}
                {link.label}
            </a>
        ))}
    </div>
</div>
