---
import { AVAILABILITY_LABEL, AVAILABLE } from '../utils/identity';

const path = Astro.url.pathname;

// Deep pages keep their section lit: a project or contribution still lives under Works.
// `featured` is declared on the type, not just one literal, so link.featured stays accessible.
const links: { href: string; label: string; match: string[]; featured?: boolean }[] = [
    { href: '/apps/', label: 'Apps', match: ['/apps'], featured: true },
    { href: '/works/', label: 'Works', match: ['/works', '/projects', '/contributions'] },
    { href: '/books/', label: 'Books', match: ['/books'] },
    { href: '/posts/', label: 'Posts', match: ['/posts'] },
];

const isCurrent = (match: string[]) =>
    match.some((p) => path === p || path.startsWith(p + '/'));
---
<div class="nav-bar">
    <div class="title-link">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Dario Mory</a>
        {/* Advisory hangs under the brand rather than joining the link row. Four
            labels is what this nav carries before it looks stuffed, and the row is
            a set of archives — things made — which an offer is not a member of. It
            is a status about the person, so it belongs against the person's name,
            in the column that was otherwise empty. AVAILABLE drives the wording and
            the dot, so a booked calendar is one flag away rather than five edits. */}
        <a
            class="nav-status"
            href="/advisory/"
            data-available={String(AVAILABLE)}
            aria-current={isCurrent(['/advisory']) ? 'page' : undefined}
        >
            <span class="status-dot" aria-hidden="true"></span>
            {AVAILABILITY_LABEL}
        </a>
    </div>
    <div class="nav-links">
        {links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
                {link.featured && (
                    <svg class="nav-holo" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
                        <g class="holo-meridians">
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                            <polygon points="0,-10 8.66,-5 8.66,5 0,10 -8.66,5 -8.66,-5" />
                        </g>
                        <polygon class="holo-core" points="0,-2.8 2.42,-1.4 2.42,1.4 0,2.8 -2.42,1.4 -2.42,-1.4" />
                    </svg>
                )}
                {link.label}
            </a>
        ))}
        <a
            href="/about/"
            class="nav-about"
            title="About"
            aria-current={isCurrent(['/about']) ? 'page' : undefined}
        >
            {/* Icon rather than a fifth text label — five labels overflow the 320px
                mobile width. The hidden span keeps real anchor text for crawlers and
                screen readers; currentColor makes it light up like the others when
                it is the current page. */}
            <svg class="about-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="8.4" fill="none" stroke="currentColor" stroke-width="1.5" />
                <circle cx="10" cy="5.8" r="1.15" fill="currentColor" stroke="none" />
                <path d="M10 9.1 v5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" />
            </svg>
            <span class="visually-hidden">About</span>
        </a>
    </div>
</div>
<style>
    /* The brand becomes a two-line block: name, then status under it. A column
       rather than a <br> so the mobile rule below only has to change the axis. */
    .title-link {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.2;
    }

    /* Scoped selectors are written as `.title-link .nav-status` so they outrank the
       `.title-link a` rules in global.css, which otherwise hand this link Pacifico
       at 1.1rem and the brand's teal underline on hover. */
    .title-link .nav-status {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        margin-top: 0.1rem;
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: #c9b8d8;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .title-link .nav-status:hover,
    .title-link .nav-status[aria-current='page'] {
        color: #78c2ad;
        text-decoration: none;
    }

    /* Same dot as the status line on /advisory/, so the marker and the page it
       leads to read as one statement. */
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #78c2ad;
        flex-shrink: 0;
        box-shadow: 0 0 0 2.5px rgba(120, 194, 173, 0.16);
    }

    .nav-status[data-available='false'] .status-dot {
        background: #d9b45f;
        box-shadow: 0 0 0 2.5px rgba(217, 180, 95, 0.16);
    }

    /* A utility rather than a fifth section: smaller than the labels, set off by a
       hairline so its position at the end reads as deliberate instead of stranded. */
    .nav-about {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 0 0.5rem 0.6rem;
        margin-left: 0.5rem;
        border-left: 1px solid rgba(253, 235, 243, 0.16);
        color: #c9b8d8;
        transition: color 0.2s ease;
    }

    .nav-about[aria-current="page"] {
        color: #78c2ad;
    }

    .about-icon {
        width: 15px;
        height: 15px;
        display: block;
    }

    .nav-about:hover .about-icon {
        color: #78c2ad;
    }

    /* Anchor text that is read but not seen. */
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    @media only screen and (max-width: 600px) {
        /* The brand is centred here, so the status centres under it too. */
        .title-link {
            align-items: center;
        }

        .nav-about {
            min-height: 44px;
            padding: 0 0.5rem 0 0.7rem;
            margin-left: 0.3rem;
        }
    }
</style>
