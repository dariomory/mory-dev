---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { logoTransitionName } from '../utils/transitionName';
const allProjects = await Astro.glob('../pages/projects/*.md');
const allContributions = await Astro.glob('../pages/contributions/*.md');
const pageTitle = "Projects & Open-Source Contributions — Dario Mory";
const description = "Projects and open-source contributions led by Dario Mory — from KLM's airport operations platform to the EU Single Digital Gateway.";

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';

/* Each project page already emits a CreativeWork (or SoftwareSourceCode for a
   contribution) at `<url>#work`, authored by the one Person node. This list ties
   them together as a single portfolio and references those same @ids, the way
   /apps/ does for the products — without it, nothing at the index level said the
   eighteen projects belong to one person. */
const entries = [...allProjects, ...allContributions];

const itemListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${siteUrl}/works/#works`,
    name: 'Projects and open-source contributions by Dario Mory',
    description,
    numberOfItems: entries.length,
    itemListElement: entries.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
            '@id': `${new URL(`${entry.url}/`, siteUrl + '/').href}#work`,
            name: entry.frontmatter.title,
            description: entry.frontmatter.description,
            author: { '@id': `${siteUrl}/#person` },
        },
    })),
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Works', item: `${siteUrl}/works/` },
    ],
};
---
<Layout
    pageTitle={pageTitle}
    description={description}
    canonicalPath="/works/"
    preloadImage="/works-hero.webp"
    jsonLd={[itemListSchema, breadcrumbSchema]}
>
    <div class="gif">
        <div class="raccoon-frame">
            <span class="frame-loader" aria-hidden="true"></span>
            <img
                width="800"
                height="450"
                alt="Illustration for the Works page"
                src="/works-hero.webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    </div>
    <h2>Contributions</h2>
    <ul role="list" class="link-card-grid">
        {allContributions.map((card) => <Card 
            url={card.url} 
            image={card.frontmatter.image.url} 
            title={card.frontmatter.title} 
            body={card.frontmatter.description}
            transitionName={logoTransitionName(card.url)}
        />)}
    </ul>
    <h2>Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => <Card 
            url={card.url} 
            image={card.frontmatter.image.url} 
            title={card.frontmatter.title} 
            body={card.frontmatter.description}
            transitionName={logoTransitionName(card.url)}
        />)}
    </ul>
</Layout>
