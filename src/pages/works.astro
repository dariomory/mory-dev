---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { logoTransitionName } from '../utils/transitionName';
const allProjects = await Astro.glob('../pages/projects/*.md');
const allContributions = await Astro.glob('../pages/contributions/*.md');
const pageTitle = "Projects & Open-Source Contributions — Dario Mory";
const description = "Projects and open-source contributions led by Dario Mory — from KLM's airport operations platform to the EU Single Digital Gateway.";
---
<Layout pageTitle={pageTitle} description={description} canonicalPath="/works/" preloadImage="/works-hero.webp">
    <div class="gif">
        <div class="raccoon-frame">
            <span class="frame-loader" aria-hidden="true"></span>
            <img
                width="800"
                height="450"
                alt="Illustration for the Works page"
                src="/works-hero.webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    </div>
    <h2>Contributions</h2>
    <ul role="list" class="link-card-grid">
        {allContributions.map((card) => <Card 
            url={card.url} 
            image={card.frontmatter.image.url} 
            title={card.frontmatter.title} 
            body={card.frontmatter.description}
            transitionName={logoTransitionName(card.url)}
        />)}
    </ul>
    <h2>Projects</h2>
    <ul role="list" class="link-card-grid">
        {allProjects.map((card) => <Card 
            url={card.url} 
            image={card.frontmatter.image.url} 
            title={card.frontmatter.title} 
            body={card.frontmatter.description}
            transitionName={logoTransitionName(card.url)}
        />)}
    </ul>
</Layout>
