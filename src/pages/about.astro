---
import Layout from '../layouts/Layout.astro';
import { contentCounts, numberWord, titleCaseNumber, yearsActive } from '../utils/counts';
import {
	BASED_IN,
	DESCRIPTION_PARTS,
	EMAIL,
	NAMED_LEAD,
	aboutFaq,
	firstSentence,
	hostOf,
	software,
} from '../utils/identity';
import * as si from 'simple-icons';
import ProfileScanner from '../components/ProfileScanner.astro';
import Faq from '../components/Faq.astro';

const n = await contentCounts();

/* Questions, canonical description and the product list all come from
   src/utils/identity.ts, so this page, the Person schema and llms.txt state the
   same facts in the same words rather than three paraphrases of them. */
const faq = await aboutFaq();

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';
const personId = `${siteUrl}/#person`;

const pageTitle = 'About Dario Mory — Engineering Leader';
/* The opening sentence of the canonical description, named, plus the location.
   A verbatim prefix of what the lede and Person.description say rather than a
   fourth phrasing — but short enough to survive a search result. */
const description = `${firstSentence(NAMED_LEAD)} Based in the ${BASED_IN}.`;

/* ProfilePage is the type Google documents for a page about one person, and it
   points at the same Person node every other page on this site references, so
   this reads as the canonical page for that entity rather than a second one. */
const profileSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	'@id': `${siteUrl}/about/#profilepage`,
	url: `${siteUrl}/about/`,
	name: pageTitle,
	description,
	inLanguage: 'en',
	mainEntity: { '@id': personId },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${siteUrl}/about/#faq`,
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

/* The portfolio, declared as one list. Each item carries the same @id the product
   page and /apps/ emit, so all three describe one node per product instead of
   three anonymous look-alikes — which is what makes different engines answer "what
   software has Dario Mory built" with different lists. */
const softwareListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	'@id': `${siteUrl}/about/#software`,
	name: 'Software built by Dario Mory',
	description: 'Products designed, built and released by Dario Mory under mory.dev.',
	numberOfItems: software.length,
	itemListElement: software.map((app, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'SoftwareApplication',
			'@id': `${siteUrl}/apps/${app.slug}/#software`,
			name: app.title,
			description: app.description,
			...(app.appCategory && { applicationCategory: app.appCategory }),
			...(app.operatingSystem && { operatingSystem: app.operatingSystem }),
			url: app.website ?? `${siteUrl}/apps/${app.slug}/`,
			mainEntityOfPage: `${siteUrl}/apps/${app.slug}/`,
			author: { '@id': personId },
		},
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'About', item: `${siteUrl}/about/` },
	],
};


/* Challenge → Approach → Outcome is a sequence, so it is drawn as one rather than
   as three paragraphs that happen to start with a bold word: a rail down the left
   with a node per phase, the Outcome node in the accent colour because that is the
   line a reader is actually here for. It also separates the four engagements from
   each other, which as four runs of plain prose they did not. */
const phasesOf = (w: { challenge: string; approach: string; outcome: string }) => [
	{ id: 'challenge', label: 'Challenge', text: w.challenge },
	{ id: 'approach', label: 'Approach', text: w.approach },
	{ id: 'outcome', label: 'Outcome', text: w.outcome },
];

/* Condensed from each project page’s own “The problem / Constraints / What I built
   / Outcome” sections. Nothing is asserted here that is not already written up in
   full one click away. */
const selectedWork = [
	{
		name: 'KLM',
		note: 'airport slot management',
		href: '/projects/klm-airport-slot-management-automation/',
		challenge: 'At a coordinated hub every arrival and departure holds a slot, and they are '
			+ 'reallocated continuously as the day drifts from the plan. The system doing that was '
			+ 'legacy scheduling infrastructure — hard to change, hard to scale into peaks, and '
			+ 'running an operation that gets no maintenance window.',
		approach: 'A microservices platform on Kubernetes and Google Cloud: Python and FastAPI at '
			+ 'the API layer, C++ for the compute-bound scheduling logic, and real-time integration '
			+ 'with the legacy systems it had to coexist with. I led the API work for a team of '
			+ 'around six engineers, established the CI/CD and infrastructure-as-code practices we '
			+ 'delivered through, and modelled the architecture in Enterprise Architect for sign-off.',
		outcome: 'A scheduling platform that could be deployed during the operating day, scaled '
			+ 'per service into demand peaks, and integrated with through a documented API rather '
			+ 'than by reaching into a database.',
	},
	{
		name: 'Single Digital Gateway',
		note: 'Dutch national CMS and API',
		href: '/projects/sdg-cms-api-development/',
		challenge: 'EU regulation requires member states to publish public-service information '
			+ 'that is findable, current and available in a second language. In the Netherlands '
			+ 'that obligation lands on every municipality, province and water authority in the '
			+ 'country, each holding its own wording of the same descriptions.',
		approach: 'Project lead for the Invoervoorziening — a CMS and an API, both on Django and '
			+ 'developed in the open. Each organisation edits from a national reference text rather '
			+ 'than a blank page, and the API publishes the result as structured data with a '
			+ 'defined update path.',
		outcome: 'One national route for Dutch government bodies to publish service information '
			+ 'uniform enough to aggregate, structured enough to reuse across national and European '
			+ 'portals, and open enough to inspect.',
	},
	{
		name: 'FlatPeak',
		note: 'Dutch energy tariff access',
		href: '/projects/flatpeak-energy-data-platform/',
		challenge: 'The product depends on knowing a specific customer’s actual electricity '
			+ 'tariff, which sits with suppliers under no obligation to hand it over. The Dutch '
			+ 'market splits across several routes at once, each with its own agreements and its '
			+ 'own idea of what a tariff record contains.',
		approach: 'I built the Dutch access layer: the integrations across those routes, plus the '
			+ 'negotiation and authorisation work that made them possible at all — behind a single '
			+ 'schema, so none of the fragmentation is visible from outside.',
		outcome: 'Dutch supplier coverage delivered through the same public API as every other '
			+ 'market, which is what makes consumption shifting a feature someone else can ship '
			+ 'without ever talking to a utility.',
	},
	{
		name: 'Betty Blocks',
		note: 'enterprise low-code platform',
		href: '/projects/bettyblocks-low-code-platform-development/',
		challenge: 'A low-code platform has to serve citizen developers who never want to see a '
			+ 'runtime and professional developers who abandon it the moment there is no escape '
			+ 'hatch. Serving only one of them produces either a toy or a framework nobody needed.',
		approach: 'Full-stack platform engineering: Elixir on the BEAM for multi-tenant '
			+ 'concurrency and fault isolation, React and TypeScript for the visual builder, '
			+ 'GraphQL between the two layers, and WebAssembly extensions as the route into custom '
			+ 'code.',
		outcome: 'Platform capability that holds both audiences at once — visual development that '
			+ 'stays genuinely visual, and a route to custom code that does not require abandoning '
			+ 'it.',
	},
];

/* Icons are 20x20 stroke paths drawn with currentColor, so a row tints with the
   accent on hover without a second asset to keep in sync. */
const icons: Record<string, string> = {
	role: 'M10 2.5 12.2 7l5 .7-3.6 3.5.9 5-4.5-2.4L5.5 16.2l.9-5L2.8 7.7l5-.7Z',
	place: 'M10 17.5s5.5-5 5.5-9a5.5 5.5 0 1 0-11 0c0 4 5.5 9 5.5 9Z M10 8.5v.01',
	time: 'M10 2.8a7.2 7.2 0 1 0 0 14.4 7.2 7.2 0 0 0 0-14.4Z M10 6.2v4.1l2.8 1.7',
	code: 'M7.2 6.4 3.2 10l4 3.6 M12.8 6.4l4 3.6-4 3.6',
	stack: 'M10 2.9 17 6.6l-7 3.7-7-3.7Z M3 10.2l7 3.7 7-3.7 M3 13.6l7 3.7 7-3.7',
	cloud: 'M6 15.2a3.4 3.4 0 0 1-.3-6.8 4.6 4.6 0 0 1 8.8-.6 3.7 3.7 0 0 1 .3 7.4Z',
	domain: 'M3.2 10a6.8 6.8 0 1 0 13.6 0 6.8 6.8 0 0 0-13.6 0Z M3.4 7.8h13.2 M3.4 12.2h13.2 M10 3.2c-3.4 3.6-3.4 10 0 13.6 3.4-3.6 3.4-10 0-13.6Z',
	mail: 'M3.2 5.6h13.6v8.8H3.2Z M3.4 6 10 10.8 16.6 6',
};

/* Drawn rather than emoji: Windows renders regional-indicator pairs as boxed
   letters, not flags, so the emoji version reads as "NL" on a large share of
   visitors' machines. */
const flags: Record<string, string> = {
	nl: '<rect width="20" height="14" fill="#21468B"/><rect width="20" height="9.34" fill="#F5F5F5"/><rect width="20" height="4.67" fill="#AE1C28"/>',
	es: '<rect width="20" height="14" fill="#AA151B"/><rect y="3.5" width="20" height="7" fill="#F1BF00"/>',
	gb: '<rect width="20" height="14" fill="#012169"/>'
		+ '<path d="M0 0 20 14M20 0 0 14" fill="none" stroke="#F5F5F5" stroke-width="2.9"/>'
		+ '<path d="M0 0 20 14M20 0 0 14" fill="none" stroke="#C8102E" stroke-width="1.5"/>'
		+ '<path d="M10 0V14M0 7H20" fill="none" stroke="#F5F5F5" stroke-width="4.6"/>'
		+ '<path d="M10 0V14M0 7H20" fill="none" stroke="#C8102E" stroke-width="2.7"/>',
	us: '<rect width="20" height="14" fill="#F5F5F5"/><rect width="20" height="2" fill="#B22234"/><rect y="4" width="20" height="2" fill="#B22234"/><rect y="8" width="20" height="2" fill="#B22234"/><rect y="12" width="20" height="2" fill="#B22234"/><rect width="9" height="8" fill="#3C3B6E"/>',
};

/* AWS and Azure are absent from simple-icons — both were withdrawn on trademark
   request — so those two render as text-only pills. */
const brand = (slug?: string) => {
	if (!slug) return null;
	const icon = (si as Record<string, { path: string; hex: string; title: string }>)[
		'si' + slug.charAt(0).toUpperCase() + slug.slice(1)
	];
	return icon ? { path: icon.path, hex: '#' + icon.hex, title: icon.title } : null;
};

type Pill = { label: string; slug?: string };

type Fact = { icon: string; term: string; value?: string; href?: string; pills?: Pill[]; flag?: string;
	countries?: { flag: string; name: string }[]; quip?: string };

const facts: Fact[] = [
	{ icon: 'role', term: 'Role', value: 'Engineering leader — hands-on, still writes code',
		quip: 'Claude drafts. I still read the diff. Mostly.' },
	{ icon: 'place', term: 'From', value: 'Spain', flag: 'es' },
	{ icon: 'place', term: 'Building in', countries: [
		{ flag: 'nl', name: 'Netherlands' },
		{ flag: 'gb', name: 'United Kingdom' },
		{ flag: 'us', name: 'United States' },
	] },
	{ icon: 'time', term: 'Active', value: `${titleCaseNumber(yearsActive())} years` },
	{ icon: 'code', term: 'Languages', pills: [
		{ label: 'Python', slug: 'python' },
		{ label: 'C / C++', slug: 'cplusplus' },
		{ label: 'JavaScript', slug: 'javascript' },
		{ label: 'TypeScript', slug: 'typescript' },
		{ label: 'Go', slug: 'go' },
		{ label: 'Rust', slug: 'rust' },
		{ label: 'Elixir', slug: 'elixir' },
	] },
	{ icon: 'stack', term: 'Builds with', pills: [
		{ label: 'Django', slug: 'django' },
		{ label: 'FastAPI', slug: 'fastapi' },
		{ label: 'Next.js', slug: 'nextdotjs' },
		{ label: 'React', slug: 'react' },
		{ label: 'Vue', slug: 'vuedotjs' },
		{ label: 'Astro', slug: 'astro' },
		{ label: 'Tauri', slug: 'tauri' },
	] },
	{ icon: 'cloud', term: 'Runs on', pills: [
		{ label: 'AWS' },
		{ label: 'Google Cloud', slug: 'googlecloud' },
		{ label: 'Azure' },
		{ label: 'Kubernetes', slug: 'kubernetes' },
		{ label: 'Cloudflare', slug: 'cloudflare' },
		{ label: 'Vercel', slug: 'vercel' },
	] },
	{ icon: 'domain', term: 'Domains', pills: [
		{ label: 'Aviation' }, { label: 'Government' }, { label: 'Energy data' },
		{ label: 'Marketplaces' }, { label: 'Developer tooling' },
	] },
	{ icon: 'mail', term: 'Contact', value: EMAIL, href: `mailto:${EMAIL}` },
];
---
<Layout
	pageTitle={pageTitle}
	description={description}
	canonicalPath="/about/"
	jsonLd={[profileSchema, faqSchema, softwareListSchema, breadcrumbSchema]}
>
	<h1>About Dario Mory</h1>

	<p class="lede">
		{NAMED_LEAD}<a href="/projects/klm-airport-slot-management-automation/">{DESCRIPTION_PARTS.klm}</a>{DESCRIPTION_PARTS.join}<a href="/projects/sdg-cms-api-development/">{DESCRIPTION_PARTS.sdg}</a>{DESCRIPTION_PARTS.end}
		Based in the Netherlands, {numberWord(yearsActive())} years in, alongside
		<a href="/apps/">{numberWord(software.length)} products released under mory.dev</a> and
		<a href="/books/">{numberWord(n.books)} books</a>.
	</p>

	<ProfileScanner />

	<h2>At a glance</h2>
	<dl class="facts">
		{facts.map((f) => (
			<div class="fact">
				<svg class="fact-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
					<path d={icons[f.icon]} />
				</svg>
				<dt>{f.term}</dt>
				<dd>
					{f.flag && (
						<svg class="fact-flag" viewBox="0 0 20 14" aria-hidden="true" focusable="false" set:html={flags[f.flag]} />
					)}
					{f.countries && (
						<span class="countries">
							{f.countries.map((c) => (
								<span class="country">
									<svg class="fact-flag" viewBox="0 0 20 14" aria-hidden="true" focusable="false" set:html={flags[c.flag]} />
									{c.name}
								</span>
							))}
						</span>
					)}
					{f.pills && (
						<span class="pills">
							{f.pills.map((t) => {
								const b = brand(t.slug);
								return (
									<span class="pill">
										{b && (
											<svg class="pill-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" style={`color:${b.hex}`}>
												<path d={b.path} fill="currentColor" />
											</svg>
										)}
										{t.label}
									</span>
								);
							})}
						</span>
					)}
					{f.value && (f.href ? <a href={f.href}>{f.value}</a> : f.value)}
					{f.quip && (
						<span class="quip" tabindex="0">
							<span class="quip-dot" aria-hidden="true"></span>
							<span class="quip-bubble" role="note">{f.quip}</span>
						</span>
					)}
				</dd>
			</div>
		))}
	</dl>

	<h2>What I do</h2>
	<p>
		Four kinds of problem come up again and again, and they are the ones I take on.
	</p>
	<p>
		<strong>Taking AI products past the demo.</strong> A prototype that answers well in a
		notebook is not a product. The distance between the two is evaluation, cost control,
		fallback behaviour when a model is wrong or slow, and a team that understands which
		model to reach for. I have run that migration and written about
		<a href="/posts/the-multi-llm-stack/">the stack it produced</a>.
	</p>
	<p>
		<strong>Systems that cannot go down.</strong> Airport slot management does not get a
		maintenance window. Neither does a public-service gateway used across the EU. That
		constraint changes architecture, deployment and how a team is organised around it.
	</p>
	<p>
		<strong>Cloud migration and high-traffic APIs.</strong> Moving load-bearing systems
		between platforms without a rewrite, and keeping them fast once the traffic arrives.
	</p>
	<p>
		<strong>Growing engineers.</strong> The leverage is rarely in my own commits. It is in
		review habits, decomposition, and the practices a team keeps under deadline pressure —
		which is what <a href="/posts/teaching-engineers-to-think-in-smaller-commits/">teaching
		engineers to think in smaller commits</a> is really about.
	</p>

	<h2>Selected work</h2>
	{selectedWork.map((w) => (
		<div class="work">
			<h3><a href={w.href}>{w.name}</a> — {w.note}</h3>
			<div class="phases">
				{phasesOf(w).map((p) => (
					<p class:list={['phase', `phase-${p.id}`]}>
						<span class="phase-label">{p.label}</span>{p.text}
					</p>
				))}
			</div>
		</div>
	))}
	<p class="work-more">
		The KLM engagement is also the subject of <a href="/books/klm-code/">The KLM Code</a>.
		{titleCaseNumber(n.projects)} projects in all, and {numberWord(n.contributions)} open-source
		contributions — to <a href="/contributions/django-open-source-contribution/">Django</a> and
		<a href="/contributions/numpy-open-source-contribution/">NumPy</a> — are listed under
		<a href="/works/">Works</a>.
	</p>

	<h2>Software built by Dario Mory</h2>
	<p>
		{titleCaseNumber(software.length)} products I design, build and release myself under mory.dev — most free and
		open source, two commercial. Each name links to its page here; the domain links to the
		product itself.
	</p>

	<div class="term" role="img" aria-label="A terminal listing of the products built and released by Dario Mory under mory.dev">
		<div class="term-bar" aria-hidden="true">
			<span class="dot dot-a"></span><span class="dot dot-b"></span><span class="dot dot-c"></span>
			<span class="term-title">dario@mory.dev — ~/apps</span>
		</div>
		<div class="term-body">
			<p class="term-cmd"><span class="prompt">$</span> ls -l ~/apps</p>
			<ul class="term-list">
				{software.map((a) => (
					<li>
						<p class="term-row">
							<a href={`/apps/${a.slug}/`}><span class="term-name">{a.title}</span></a>
							{a.website && (
								<a class="term-host" href={a.website} rel="noopener">{hostOf(a.website)}</a>
							)}
						</p>
						<p class="term-meta">
							{a.status && <span class="term-status">{a.status}. </span>}
							{firstSentence(a.description)}
						</p>
					</li>
				))}
			</ul>
			<p class="term-cmd term-foot">
				<span class="prompt">$</span> <a href="/apps/">open ./apps</a><span class="cursor" aria-hidden="true"></span>
			</p>
		</div>
		<div class="scanlines" aria-hidden="true"></div>
	</div>

	<h2>Writing and speaking</h2>
	<p>
		{titleCaseNumber(n.books)} books — <a href="/books/klm-code/">The KLM Code</a>, on tech, power and politics
		inside a national carrier, and
		<a href="/books/building-bots-and-scrapers-with-python/">Building Bots and Scrapers
		with Python</a>. Articles on AI engineering, reverse engineering and leadership are
		collected under <a href="/posts/">Posts</a>.
	</p>
	<p>
		I speak at conferences on AI engineering and software leadership. Organising an event?
		<a href="mailto:dario@mory.dev?subject=Speaking%20inquiry">Get in touch</a>.
	</p>

	<h2>Questions</h2>
	<Faq items={faq} />

	<h2>Working together</h2>
	<p>
		The work that suits me best is leading a team through something hard: an AI product
		that has to become real, a migration that cannot break, a codebase that needs to
		outlive the people who wrote it. Consulting, fractional leadership and advisory all
		work.
	</p>
	<p>
		I take fractional CTO, fractional VP of Engineering, advisory and consulting engagements,
		and I am available now — <a href="/advisory/">what that looks like, and how to start</a>.
	</p>
	<p>
		Reach me at <a href="mailto:dario@mory.dev">dario@mory.dev</a>, or on
		<a href="https://github.com/dariomory" rel="me">GitHub</a>.
	</p>
</Layout>
<style>
	h1 {
		font-size: 1.5em;
		text-decoration: underline #375a7f;
		text-decoration-thickness: 4px;
		text-underline-offset: 6px;
		margin: 0.83em 0 0;
	}

	h2 {
		font-family: 'Josefin Sans', sans-serif;
		font-size: 1.15em;
		text-decoration: none;
		color: #fdebf3;
		margin: 2em 0 0;
	}

	.lede {
		font-size: 1.05em;
		color: #fdebf3;
	}

	/* Challenge / Approach / Outcome, one block per engagement. Each line is a
	   condensed form of the matching section on the project page it links to. */
	.work {
		margin-top: 1.7em;
	}

	.work h3 {
		font-family: 'Josefin Sans', sans-serif;
		font-size: 0.98em;
		color: #fdebf3;
		margin: 0 0 0.25em;
	}

	/* Offsets are in px, not em: the rail is positioned against .phases at 1em and
	   the nodes against .phase at 0.92em, so the same em value would resolve to two
	   different distances and the nodes would sit off the line. */
	.phases {
		position: relative;
		margin-top: 0.5em;
		padding-left: 19px;
	}

	.phases::before {
		content: "";
		position: absolute;
		left: 3px;
		top: 0.62em;
		bottom: 0.7em;
		width: 1px;
		background: linear-gradient(
			to bottom,
			rgba(201, 184, 216, 0.14),
			rgba(201, 184, 216, 0.38) 32%,
			rgba(120, 194, 173, 0.5)
		);
	}

	.phase {
		position: relative;
		margin: 0;
		font-size: 0.92em;
		line-height: 1.55;
		text-indent: 0;
	}

	.phase + .phase {
		margin-top: 0.62em;
	}

	.phase::before {
		content: "";
		position: absolute;
		left: -19px;
		top: 0.44em;
		width: 7px;
		height: 8px;
		background: #c9b8d8;
		clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
	}

	.phase-challenge::before {
		opacity: 0.5;
	}

	/* The arrival gets the accent and the same faint halo as the availability dot
	   in the nav, so "this worked" reads at a glance without being read. */
	.phase-outcome::before {
		background: #78c2ad;
		box-shadow: 0 0 0 2.5px rgba(120, 194, 173, 0.14);
	}

	.phase-label {
		font-family: 'Josefin Sans', sans-serif;
		font-size: 0.76em;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: #c9b8d8;
		margin-right: 0.6em;
	}

	.phase-outcome .phase-label {
		color: #78c2ad;
	}

	.work-more {
		margin-top: 1.3em;
		text-indent: 0;
	}

