---
const description = "404";
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, follow" />
    <title>404 — Page not found — Dario Mory</title>
    <meta name="description" content="That page doesn't exist on mory.dev." />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-round-512.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-round-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<section class="container404"></section>
<div class="gif">
    <img width="220" height="180" alt="Raccoon404Gif" src="/404.webp"/>
</div>
<h1>{ description }</h1>
<span>It seems like you've wandered into the wrong forest!</span>
<p>
    <a href="/">Return Home</a>
</p>
</body>
</html>
<style>
    body {
        text-align: center;
    }

    .container404 {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        margin: 16%;
    }

    h1 {
        margin: 0 auto;
        text-align: center;
        border: 0;
        font-size: 100px;
        letter-spacing: 8px;

    }

    span {
        color: #5C5B77;
    }

    a {
        color: #78c2ad;
        text-decoration: none;
    }
</style>
