---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import AppsHero from '../../components/AppsHero.astro';
import { logoTransitionName } from '../../utils/transitionName';

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';

// Maturity order is editorial, set per page in frontmatter — alphabetical would
// bury the shipped products behind the pre-alpha one.
const apps = (await Astro.glob('./*.md')).sort(
    (a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99),
);

const pageTitle = 'Apps by Dario Mory — software released under mory.dev';
const description =
    'Nine products built and released under mory.dev: marketplace intelligence, developer tools, a photo editor, a browser extension. Most are free and open source.';

const itemListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Apps by Dario Mory',
    description,
    numberOfItems: apps.length,
    itemListElement: apps.map((app, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
            '@type': 'SoftwareApplication',
            name: app.frontmatter.title,
            description: app.frontmatter.description,
            url: new URL(`${app.url}/`, siteUrl + '/').href,
            ...(app.frontmatter.appCategory && {
                applicationCategory: app.frontmatter.appCategory,
            }),
            author: { '@id': `${siteUrl}/#person` },
        },
    })),
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Apps', item: `${siteUrl}/apps/` },
    ],
};
---
<Layout
    pageTitle={pageTitle}
    description={description}
    canonicalPath="/apps/"
    jsonLd={[itemListSchema, breadcrumbSchema]}
>
    <AppsHero apps={apps} />
    <h1>Apps</h1>
    <p class="intro">
        Software I build and release myself, under mory.dev — as opposed to the client work and
        open-source contributions over in <a href="/works/">Works</a>. Marketplace intelligence,
        developer tools, a photo editor, a browser extension. Most are free and open source; a
        couple are commercial; one is honestly labelled pre-alpha.
    </p>
    <ul role="list" class="link-card-grid">
        {apps.map((app) => (
            <Card
                url={`${app.url}/`}
                image={app.frontmatter.image.url}
                title={app.frontmatter.title}
                body={app.frontmatter.tagline ?? app.frontmatter.description}
                transitionName={logoTransitionName(app.url)}
            />
        ))}
    </ul>
</Layout>
<style>
    h1 {
        font-size: 1.8em;
        text-decoration: underline #375a7f;
        text-decoration-thickness: 4px;
        text-underline-offset: 6px;
        margin-top: 0;
        margin-bottom: 0.6rem;
    }

    .intro {
        text-indent: 0;
        margin-bottom: 1.4rem;
    }

    .intro a {
        color: #78c2ad;
        text-decoration: none;
    }

    .intro a:hover,
    .intro a:focus-visible {
        text-decoration: underline;
        text-underline-offset: 3px;
    }
</style>
