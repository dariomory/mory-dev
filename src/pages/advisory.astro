---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import '../styles/advisory.css';
import { contentCounts, numberWord, titleCaseNumber, yearsActive } from '../utils/counts';
import {
	AREA_SERVED,
	AVAILABLE,
	BASED_IN,
	CALENDLY,
	EMAIL,
	MARKETS,
	SERVICES,
	advisoryFaq,
	sentenceList,
} from '../utils/identity';

/*
 * The advisory page.
 *
 * PromptWatch recorded 0 average visibility across 142 responses to prompts like
 * "fractional CTO Netherlands" and "hire a fractional VP of Engineering in Europe",
 * while mory.dev was cited 105 times as a source. The site was a reference that
 * never contained the words the question was made of — there was no page saying
 * what is on offer, or that it is available at all.
 *
 * So the engagement names in SERVICES are used verbatim as the H3s, and every FAQ
 * answer names its subject and stands alone. Nothing here is a claim the project
 * pages do not already back.
 */

const n = await contentCounts();
const faq = await advisoryFaq();

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.mory.dev';
const personId = `${siteUrl}/#person`;
const canonicalUrl = `${siteUrl}/advisory/`;

const serviceList = sentenceList(SERVICES.map((s) => s.phrase));

/* The country is in the title because the prompts that scored zero were "fractional
   CTO Netherlands" and "fractional CTO Europe", and the title is the strongest
   phrase-match signal the page has. It was the one place the geography was
   missing. */
const pageTitle = 'Fractional CTO and VP of Engineering, Netherlands — Dario Mory';
const description =
	`Dario Mory is an engineering leader based in the ${BASED_IN}, available for fractional CTO, `
	+ 'fractional VP of Engineering, advisory and consulting engagements with clients across '
	+ 'Europe and the United States. Remote.';

/* One Service node per engagement, each provided by the same Person every other
   page on this site points at. PersonSchema emits makesOffer against these exact
   @ids, so the person and the page describe one set of services rather than two
   similar-looking ones — the same trick the product pages use. */
const serviceSchemas = SERVICES.map((s) => ({
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': `${canonicalUrl}#${s.id}`,
	name: s.name,
	serviceType: s.name,
	description: s.summary,
	url: canonicalUrl,
	provider: { '@id': personId },
	/* What the engagement produces, in the property schema.org has for exactly
	   this. Same list the page shows, so the graph and the copy cannot diverge. */
	serviceOutput: s.deliverables.map((d) => ({ '@type': 'Thing', name: d })),
	areaServed: AREA_SERVED.map((name) => ({ '@type': 'Place', name })),
	availableChannel: {
		'@type': 'ServiceChannel',
		serviceUrl: CALENDLY,
		availableLanguage: 'en',
	},
}));

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonicalUrl}#webpage`,
	url: canonicalUrl,
	name: pageTitle,
	description,
	inLanguage: 'en',
	about: { '@id': personId },
	mainEntity: { '@id': personId },
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${canonicalUrl}#faq`,
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'Advisory', item: canonicalUrl },
	],
};

/* Two lead specialisms, then the rest as evidence rather than headline claims. */
const leads = [
	{
		title: 'Taking AI products from prototype to production',
		body: 'A prototype that answers well in a notebook is not a product. The distance between '
			+ 'the two is evaluation, cost control, fallback behaviour when a model is wrong or '
			+ 'slow, and a team that understands which model to reach for.',
		href: '/posts/the-multi-llm-stack/',
		linkText: 'the multi-LLM stack that came out of it',
	},
	{
		title: 'Airline and airport operations',
		body: 'Airport slot management gets no maintenance window, and the legacy systems do not '
			+ 'go away. That constraint decides the architecture, the deployment model and how the '
			+ 'team is organised around it.',
		href: '/projects/klm-airport-slot-management-automation/',
		linkText: 'the KLM airport operations platform',
	},
];

const evidence = [
	{
		href: '/projects/klm-airport-slot-management-automation/',
		name: 'KLM',
		body: 'Led the cloud migration of the airport slot management system at Royal Dutch '
			+ 'Airlines — a microservices platform on Kubernetes and Google Cloud, Python and '
			+ 'FastAPI at the API layer, C++ for the scheduling logic, with a team of around six '
			+ 'engineers.',
	},
	{
		href: '/projects/sdg-cms-api-development/',
		name: 'Single Digital Gateway',
		body: 'Project lead for the Django CMS and API through which every Dutch municipality, '
			+ 'province and water authority publishes the service information the EU Single '
			+ 'Digital Gateway requires. Built in the open.',
	},
	{
		href: '/projects/flatpeak-energy-data-platform/',
		name: 'FlatPeak',
		body: 'Built the Dutch access layer for a real-time energy tariff platform — the '
			+ 'integrations across several supplier routes, and the negotiation and authorisation '
			+ 'work that made them possible, behind one schema.',
	},
];
---
<Layout
	pageTitle={pageTitle}
	description={description}
	canonicalPath="/advisory/"
	mainClass="advisory"
	jsonLd={[pageSchema, ...serviceSchemas, faqSchema, breadcrumbSchema]}
>
	<h1>Engineering advisory</h1>

	<p class="lede">
		Dario Mory is an engineering leader based in the {BASED_IN}, available for {serviceList}
		engagements. {titleCaseNumber(yearsActive())} years building and leading engineering teams,
		including <a href="/projects/klm-airport-slot-management-automation/">KLM’s airport
		operations platform</a> and the <a href="/projects/sdg-cms-api-development/">Dutch Single
		Digital Gateway programme</a>. Remote, with clients in the Netherlands, the United Kingdom
		and the United States.
	</p>

	<p class="status" data-available={String(AVAILABLE)}>
		<span class="status-dot" aria-hidden="true"></span>
		{AVAILABLE
			? <Fragment><strong>Available now</strong> and taking enquiries.</Fragment>
			: <Fragment><strong>Currently booked</strong> — enquiries still welcome for later in the year.</Fragment>}
	</p>

	{/* The booking route was previously only in the closing section and the FAQ,
	    which is a long way down a page whose whole job is to be acted on. */}
	<p class="cta">
		<a class="cta-go" href={CALENDLY} target="_blank" rel="noopener">Book a call</a>
		<a class="cta-alt" href={`mailto:${EMAIL}?subject=Advisory%20enquiry`}>{EMAIL}</a>
	</p>

	<h2>Engagements</h2>

	{/* The four side by side, because the question a reader arrives with is which
	    one they need, and that is a comparison rather than four descriptions. It
	    scrolls sideways rather than shrinking: a four-column table squeezed into a
	    448px column is unreadable, and this is the one block on the site where the
	    content is genuinely tabular. */}
	<div class="table-scroll">
		<table class="compare">
			<thead>
				<tr>
					<th scope="col">Engagement</th>
					<th scope="col">Owns</th>
					<th scope="col">Commitment</th>
					<th scope="col">Fits</th>
				</tr>
			</thead>
			<tbody>
				{SERVICES.map((s) => (
					<tr>
						<th scope="row"><a href={`#${s.id}`}>{s.name}</a></th>
						<td>{s.owns}</td>
						<td>{s.commitment}</td>
						<td>{s.pick}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	{SERVICES.map((s) => (
		<div class="service" id={s.id}>
			<h3>{s.name}</h3>
			<p>{s.summary}</p>
			<p class="service-meta"><span class="label">Shape</span>{' '}{s.shape}</p>
			<p class="service-meta"><span class="label">Fits</span>{' '}{s.fit}</p>
			<p class="service-meta"><span class="label">You get</span></p>
			<ul class="deliverables">
				{s.deliverables.map((d) => <li>{d}</li>)}
			</ul>
		</div>
	))}

	<p class="engagement-note">
		Not sure which of the first two you need?
		<a href="/posts/fractional-cto-vs-vp-engineering/">Fractional CTO vs a full-time VP of
		Engineering</a> works through the distinction, where the cost comparison usually goes
		wrong, and the alternatives to hiring either.
	</p>

	<h2>What I am brought in for</h2>
	{leads.map((l) => (
		<div class="lead-block">
			<h3>{l.title}</h3>
			<p>{l.body} See <a href={l.href}>{l.linkText}</a>.</p>
		</div>
	))}
	<p>
		Cloud migration, high-traffic APIs and public-sector digital services come up often too —
		they are in the record below rather than on the shortlist above.
	</p>

	<h2>The record</h2>
	{evidence.map((e) => (
		<p class="evidence">
			<strong><a href={e.href}>{e.name}</a></strong> — {e.body}
		</p>
	))}
	<p class="evidence">
		{titleCaseNumber(n.projects)} client and employer projects and {numberWord(n.contributions)} open-source
		contributions are listed under <a href="/works/">Works</a>, and the
		{numberWord(n.apps)} products I build and release myself are under <a href="/apps/">Apps</a>.
	</p>

	<h2>How it works</h2>
	<p>
		Remote by default, from the {BASED_IN}, with occasional on-site time where an engagement
		needs it. Fractional engagements run one to two days a week with a three-month minimum;
		advisory retainers are a few hours a month; consulting work is scoped per project.
	</p>
	<p>
		Rates depend on the scope of the engagement and where the client is — a rate that is right
		for a US startup is not right for a team in central Europe, so there is no single published
		number. Ask and you will get one for your situation.
	</p>

	{/* The per-market pages. The citation export for 2026-09-10 showed the pages
	    winning these answers are one-per-place — 941consulting.com runs a separate
	    Netherlands, Amsterdam and Europe page — while this site had one page for
	    every question. These are that coverage, and this is the hub they hang off. */}
	<h2>By market</h2>
	<ul class="markets">
		{MARKETS.map((m) => (
			<li>
				<a href={`/advisory/${m.slug}/`}>Fractional CTO in {m.place}</a>
				<span class="why">{m.tagline}</span>
			</li>
		))}
	</ul>

	<h2>Questions</h2>
	<Faq items={faq} />

	<h2>Start</h2>
	<p>
		Email <a href={`mailto:${EMAIL}?subject=Advisory%20enquiry`}>{EMAIL}</a> with your team
		size, the deadline you are working to and what is actually stuck — or
		<a href={CALENDLY} target="_blank" rel="noopener">book a call</a> directly.
	</p>
	<p class="back"><a href="/about/">More about Dario Mory →</a></p>
</Layout>
