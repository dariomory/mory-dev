---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
const pageTitle = "Dario Mory";
const description = "Dario Mory — engineering leader who still writes the code. Speaker on AI engineering and software leadership. Previously KLM and the EU Single Digital Gateway.";
---
<Layout pageTitle={pageTitle} description={description} canonicalPath="/" preloadImage="/raccoon-coder.webp">
    <div class="gif">
        <div class="raccoon-frame">
            <span class="frame-loader" aria-hidden="true"></span>
            <img
                width="800"
                height="450"
                alt="Illustration of a raccoon coding at a desk with monitors at night"
                src="/raccoon-coder.webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />
        </div>
    </div>
    <h1>Dario Mory</h1>
    <small>Engineering Leader</small>
    <h2>About</h2>
    <p>
        I build and lead engineering teams that ship software and AI-powered products-from prototype to production. Past work includes <a href="/projects/klm-airport-slot-management-automation/">KLM's airport operations stack</a>, the <a href="/projects/sdg-cms-api-development/">Single Digital Gateway programme</a> for Dutch and EU public services, and startups across Europe and the US.
    </p>
    <p>
        Code that ships, teams that grow-that's what matters. Cloud migrations, high-traffic APIs, and early-stage products taken to production are the kinds of problems that keep things interesting.
    </p>
    <p>
        I speak at conferences on AI engineering and software leadership. Organizing an event? <a href="mailto:dario@mory.dev?subject=Speaking%20inquiry">Get in touch</a>.
    </p>
    <Newsletter />
</Layout>
<style>
    /* Hero kicker: an editorial line trailing off the name, not a badge */
    small {
        display: flex;
        align-items: center;
        gap: 0.7em;
        text-align: left;
        text-indent: 0;
        font-family: 'Josefin Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: rgba(253, 235, 243, 0.55);
        margin: 0.6rem 0 0;
    }

    /* Hairline in the hero frame's brass, fading out so the line trails away */
    small::before {
        content: "";
        flex: 0 0 auto;
        width: 26px;
        height: 1px;
        background: linear-gradient(90deg, rgba(168, 144, 102, 0.8), rgba(168, 144, 102, 0.15));
    }

    /* Hero tagline: subtle bubble lead-in with a tail toward the name */
    .tagline {
        position: relative;
        display: inline-block;
        font-size: 1.05rem;
        font-family: 'Josefin Sans', sans-serif;
        font-style: italic;
        color: #c9b8d8;
        text-indent: 0;
        background: rgba(253, 235, 243, 0.045);
        border: 1px solid rgba(253, 235, 243, 0.09);
        border-radius: 12px;
        padding: 0.55em 1em;
        margin: 0.9em 0 1.6em;
        max-width: 520px;
        line-height: 1.5;
    }

    .tagline::before {
        content: "";
        position: absolute;
        top: -6px;
        left: 26px;
        width: 10px;
        height: 10px;
        background: rgba(253, 235, 243, 0.045);
        border-left: 1px solid rgba(253, 235, 243, 0.09);
        border-top: 1px solid rgba(253, 235, 243, 0.09);
        border-top-left-radius: 2px;
        transform: rotate(45deg);
    }

    /* Button */
    button {
        background: rgba(0,0,0,0);
        border: 2px solid #78c2ad;
        border-radius: 8px;
        color: #fdebf3;
        font: 600 14px 'Josefin Sans', sans-serif;
        padding: 8px 16px;
        transition: background-color 0.4s, color 0.4s;
    }

    button:hover {
        background-color: #78c2ad;
        color: #1e1e2e;
        cursor: pointer;
    }

    .button {
        text-align: center;
    }

    /* Skill images */
    .link-images img {
        margin: 16px 4px;
    }

    @media only screen and (max-width: 600px) {
        .link-images img {
            height: 30px;
            width: 30px;
            margin: 16px 1px;
        }
    }

    a {
        color: #78c2ad;
        text-decoration: none;
    }

    a:hover,
    a:focus-visible {
        text-decoration: underline;
        text-underline-offset: 3px;
    }
</style>
